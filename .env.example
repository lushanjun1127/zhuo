# 本地 Ollama 推理地址（应用内连接设置可以覆盖模型和连接参数）
ZHUO_API_BASE=http://127.0.0.1:11434/v1
ZHUO_API_KEY=ollama
ZHUO_OLLAMA_NATIVE=1

# 主聊天模型和提取模型优先在网页右上角“设置”面板中选择
# ZHUO_MODEL=
# ZHUO_SUMMARY_MODEL=

# 主模型 GPU 层数默认值；设置面板可动态覆盖。6GB 显卡建议从 15 开始
ZHUO_MAIN_NUM_GPU=15

# Ollama 启动参数；若 Ollama 已经在运行，需重启 Ollama 后才生效
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# 可选后端参数
# ZHUO_SUMMARY_ROUNDS=8
# ZHUO_DB=zhuo.db
# ZHUO_CARDS_DIR=examples
# ZHUO_WORLD=examples/world.json
# ZHUO_MAX_CHARS=12000
# ZHUO_PORT=1127
